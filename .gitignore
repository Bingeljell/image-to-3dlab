.DS_Store
.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
output/

# Personal/local-network artifacts — real Tailscale IP baked in, never for the tracked repo.
/scripts/image_gallery.py

# Our own investigation/session logs — useful to us, not to someone using this repo.
# Nothing here is a real loss if it only exists in past commit history.
/journal/

# Where *we* pick up next session: half-finished lanes, things owed, what is parked and
# why. Written for us, and it reads like a to-do list rather than documentation, which is
# not what someone cloning this repo wants from docs/. Untracked 2026-09-21 with
# `git rm --cached`; the file stays on disk and its history stays in the repo.
/docs/resume-guidance.md

# Reference photos exchanged between collaborators, not test fixtures for the pipeline.
/images_for_you/

# Anchored to the repo root on purpose. The multi-GB backend checkouts live in /vendor/;
# an unanchored `vendor/` also swallowed viewer/vendor/ (1.5 MB of MIT three.js), which
# silently shipped a viewer that renders a blank page on a fresh clone.
/vendor/

# hunyuan_mlx/ is tracked code (Xiong's MIT-licensed shape+paint port, brought in-repo
# 2026-08-19 so a clone doesn't need vendor/hunyuan-mlx-paint cloned separately) — but
# weights are multi-GB and downloaded, not committed.
/hunyuan_mlx/shape/weights/
/hunyuan_mlx/paint/weights/
# The paint stage writes its results next to its own code. 64 MB per run on the first
# try, and a repository deliberately cut to 8.5 MB cannot absorb that.
/hunyuan_mlx/paint/outputs/
/hunyuan_mlx/shape/outputs/


# Generated HyperFrames video content (caches, thumbnails, snapshots, audio assets)
videos/image-to-3d-lab/.hyperframes/
videos/image-to-3d-lab/.thumbnails/
videos/image-to-3d-lab/.waveform-cache/
videos/image-to-3d-lab/snapshots/
videos/image-to-3d-lab/audio-v2/
videos/image-to-3d-lab/audio-v3/
videos/image-to-3d-lab/audio-v4/
videos/image-to-3d-lab/assets/audio-v2/
videos/image-to-3d-lab/assets/audio-v3/
videos/image-to-3d-lab/assets/audio-v4/
videos/image-to-3d-lab/assets/fonts/

# --- local-only working material (2026-09-19) ---------------------------------
# These stay on disk; they are simply not part of what a user clones to run the
# image -> 3D pipeline. Untracked with `git rm --cached`, so nothing was deleted.

# Promo-video project. Its own BRIEF/AGENTS/bugs tree, audio masters and renders
# -- a separate project that happened to live here. 133 MB.
videos/

# Reference meshes and source art used to evaluate backends. Useful locally,
# but 90 MB of GLB that no one needs in order to run the pipeline.
assets_to_test/

# Per-character rigs, animations and their tests. The pipeline is the product;
# individual creatures are our own content. See characters/README.md.
characters/

# Our own run records. Each points at source art in assets_to_test/, which is not part
# of the repository, so none of them run for anyone else -- they were never examples.
# The template is the exception and stays tracked.
manifests/*.json
!manifests/example-trellis2.json

# Private agent rules: never committed (AGENTS.md says to read them first)
AGENTS.local.md
CLAUDE.local.md
